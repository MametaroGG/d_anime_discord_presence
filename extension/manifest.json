{
    "name": "dアニメ Discord Presence+",
    "version": "0.2.0",
    "description": "dアニメストアの視聴中作品名・話数・サブタイトルをDiscordのPresenceに表示します。",
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "manifest_version": 3,
    "key": "",
    "homepage_url": "https://github.com/MametaroGG/d_anime_discord_presence",
    "content_scripts": [
        {
            "matches": [
                "https://animestore.docomo.ne.jp/animestore/sc_d_pc*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "permissions": [
        "nativeMessaging",
        "storage"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "background": {
        "service_worker": "background.js"
    }
}
